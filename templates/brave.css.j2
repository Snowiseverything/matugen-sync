/* Matugen-sync Brave/Chrome theme */
:root {
  --matugen-primary: {{ primary }};
  --matugen-on-primary: {{ on_primary }};
  --matugen-primary-container: {{ primary_container }};
  --matugen-on-primary-container: {{ on_primary_container }};
  --matugen-secondary: {{ secondary }};
  --matugen-on-secondary: {{ on_secondary }};
  --matugen-background: {{ background }};
  --matugen-on-background: {{ on_background }};
  --matugen-surface: {{ surface }};
  --matugen-on-surface: {{ on_surface }};
  --matugen-surface-variant: {{ surface_variant }};
  --matugen-on-surface-variant: {{ on_surface_variant }};
  --matugen-error: {{ error }};
  --matugen-on-error: {{ on_error }};
}
