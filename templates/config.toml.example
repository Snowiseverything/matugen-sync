# ~/Dotfiles/matugen/config.toml

[config]
reload_apps = true
source_color_index = 0

[templates.hyprland]
input_path = '~/Dotfiles/matugen/templates/hyprland-colors.conf'
output_path = '~/.cache/skwd-wall/hyprland-colors.conf'

[templates.kitty]
input_path = '~/Dotfiles/matugen/templates/kitty-colors.conf'
output_path = '~/.cache/skwd-wall/colors-kitty.conf'

[templates.fuzzel]
input_path = '~/Dotfiles/matugen/templates/fuzzel-colors.ini'
output_path = '~/.cache/skwd-wall/fuzzel-colors.ini'

[templates.skwd]
input_path = '~/Dotfiles/matugen/templates/skwd-colors.json'
output_path = '~/.cache/skwd-wall/colors.json'

[templates.caelestia]
input_path = '~/Dotfiles/matugen/templates/caelestia-scheme.json'
output_path = '~/.local/state/caelestia/scheme.json'

[templates.swaync]
input_path = '~/Dotfiles/matugen/templates/swaync.css'
output_path = '~/.cache/skwd-wall/swaync.css'

[templates.steam]
input_path = '~/Dotfiles/matugen/templates/steam-millennium.css'
output_path = '~/.local/share/Steam/steamui/skins/Material-Theme/css/main/colors/matugen.css'

[templates.steam_transparency]
input_path = '~/Dotfiles/matugen/templates/steam-transparency.css'
output_path = '~/.local/share/Steam/steamui/skins/Material-Theme/css/main/transparency.css'

[templates.steam_experimental]
input_path = '~/Dotfiles/matugen/templates/steam-experimental-header.css'
output_path = '~/.local/share/Steam/steamui/skins/Material-Theme/experimental-import.css'

[templates.vencord]
input_path = '~/Dotfiles/matugen/templates/vencord.css'
output_path = '~/.config/Vencord/themes/matugen.theme.css'

[templates.brave]
input_path = '~/Dotfiles/matugen/templates/brave.css'
output_path = '~/.config/BraveSoftware/Brave-browser/current-theme.css'

[templates.gtk3]
input_path = '~/Dotfiles/matugen/templates/gtk.css'
output_path = '~/.config/gtk-3.0/gtk.css'

[templates.gtk4]
input_path = '~/Dotfiles/matugen/templates/gtk.css'
output_path = '~/.config/gtk-4.0/gtk.css'

[templates.spicetify]
input_path = '~/Dotfiles/matugen/templates/spicetify.ini'
output_path = '~/.config/spicetify/Themes/Matugen/color.ini'

[templates.starship]
input_path = '~/Dotfiles/matugen/templates/starship.toml'
output_path = '~/.config/starship.toml'

[templates.opencode]
input_path = '~/Dotfiles/matugen/templates/opencode.json'
output_path = '~/.config/opencode/themes/matugen.json'
reload = true

[post_processing]
command = "~/Dotfiles/scripts/wall-sync.sh"
run_on_change = true
